# Generate a private key: openssl rand -hex 32
API_KEY=
WHATSAPP_PORT=3001

# Backend callback is prepared here; its Sewain endpoint is not implemented yet.
# If Spring runs in another container, use its Compose service hostname instead.
BASE_WEBHOOK_URL=http://host.docker.internal:8080/api/integrations/whatsapp/webhook
ENABLE_SWAGGER_ENDPOINT=false
WHATSAPP_MEMORY_LIMIT=1g
WHATSAPP_CPU_LIMIT=1.0
DISABLED_CALLBACKS=message_reaction|unread_count|message_edit|message_ciphertext
