# Copy to .env at the repository root and fill the three required secrets.
POSTGRES_DB=sewain
POSTGRES_USER=sewain
POSTGRES_PASSWORD=
WHATSAPP_API_KEY=
# Generate: openssl rand -base64 32. Keep this key stable across deployments.
INTEGRATIONS_ENCRYPTION_KEY=

WEB_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5433
WHATSAPP_PORT=3001
PUBLIC_API_URL=http://localhost:8080
# Local Compose migrates existing tenant schemas during backend startup.
MIGRATE_TENANTS=true
BACKEND_MEMORY_LIMIT=1536m
BACKEND_CPU_LIMIT=2.0
WEB_MEMORY_LIMIT=768m
WHATSAPP_MEMORY_LIMIT=1g
WHATSAPP_CPU_LIMIT=1.0
